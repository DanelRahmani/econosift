# Optional, free to obtain at https://fred.stlouisfed.org/docs/api/api_key.html
# If omitted, the app falls back to pandas-datareader / World Bank / IMF.
FRED_API_KEY=your_free_key_here

# Optional, free tier at https://finnhub.io/register
# Used for the economic/earnings/IPO calendar (Phase 4) and live ISM PMI (Phase 8).
# If omitted, those features degrade gracefully to FRED / yfinance / cached data.
FINNHUB_API_KEY=your_free_key_here

# Database (SQLite by default — no setup needed)
DATABASE_URL=sqlite:///./data/axiomfinance.db

# Background job scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
