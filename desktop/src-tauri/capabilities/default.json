{
  "identifier": "default",
  "description": "Default capabilities for Axiom Finance",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-stdin-write",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-message",
    "dialog:allow-ask",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/AxiomFinance/**" }
      ]
    },
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install"
  ]
}
